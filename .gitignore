# Root build outputs and local dependencies; do not ignore source files named build*.
/build/
/build-*/
/cmake-build*/
/dist/
/vcpkg/
/vcpkg_installed/
/.tooling/
/.tools/
/.cache/
/.gradle/
/.codex/
/.codex-remote-attachments/
/%SystemDrive%/
/compile_commands.json
/CMakeCache.txt
/CMakeFiles/

# Import/build caches, not the source .uid or per-resource .import settings.
**/.godot/
**/__pycache__/
*.pyc
*.pyo
*.log
.DS_Store

# Private signing inputs.
*.keystore
*.jks
